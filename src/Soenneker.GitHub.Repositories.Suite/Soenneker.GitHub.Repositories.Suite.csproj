<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Registers commonly used Soenneker GitHub repository services through one package</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.GitHub.Repositories.Suite</AssemblyName>
        <PackageId>Soenneker.GitHub.Repositories.Suite</PackageId>
        <PackageTags>github repositories suite repository repo utilities util issues runs actions builds pull requests githubrepositorysuite csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2024-2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.github.repositories.suite</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.github.repositories.suite</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">
            $(PACKAGE_RELEASE_NOTES)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.GitHub.Repositories.Discussions" Version="11.0.1650" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Issues" Version="11.0.1249" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Pages" Version="11.0.765" />
        <PackageReference Include="Soenneker.GitHub.Repositories.PullRequests" Version="11.0.2046" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Readmes" Version="11.0.1125" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Releases" Version="11.0.1108" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Rulesets" Version="11.0.1718" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Secrets" Version="11.0.1224" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Security" Version="11.0.217" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Subscriptions" Version="11.0.418" />
    </ItemGroup>
    <ItemGroup>
    </ItemGroup>
</Project>
